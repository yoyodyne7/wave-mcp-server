  "description": "Unofficial MCP server for Wave (waveapps.com) invoicing: customers, invoices, products and payments, with a preview-then-confirm step for anything that sends or records money.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wave",
    "waveapps",
    "invoicing",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoyodyne7/wave-mcp-server.git"
  },
